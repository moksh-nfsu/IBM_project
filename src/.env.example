# ThreatLens environment. Copy to src/.env (git-ignored) and fill in.

# IBM Bob API key (Bob web portal -> API keys, scope "Inference").
# ThreatLens calls IBM Bob Shell headless: install it with
#   powershell -c "irm -Uri https://bob.ibm.com/download/bobshell.ps1 | iex"   (needs Node.js 24+)
BOB_API_KEY=your_bob_api_key_here
# Only for API keys of type "general":
# BOB_TEAM_ID=
# Seconds to wait for one Bob batch (20 posts):
# BOB_TIMEOUT_S=240

# auto  = cached Bob answers -> IBM Bob -> offline rules
# bob   = always ask Bob again (refreshes the cache)
# rules = offline lexicon rules only
LLM_MODE=auto
